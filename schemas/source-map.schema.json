{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ir-reference-packs/schemas/source-map.schema.json",
  "title": "Source map (source-map.json) for unpaginated web sources: one unit per captured article",
  "type": "object",
  "required": ["schema_version", "document_id", "route", "snapshot", "units"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "document_id": {"type": "string"},
    "route": {"type": "string"},
    "snapshot": {"type": "string"},
    "units": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["unit_id", "title", "url", "source_id", "sha256", "git_commit_id", "updated_at", "document_id",
                     "body_text_sha256", "sections"],
        "properties": {
          "unit_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "title": {"type": "string", "minLength": 1},
          "url": {"type": "string", "pattern": "^https://"},
          "source_id": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "git_commit_id": {"type": ["string", "null"]},
          "updated_at": {"type": ["string", "null"]},
          "ms_date": {"type": ["string", "null"]},
          "document_id": {"type": ["string", "null"]},
          "source_path": {"type": ["string", "null"]},
          "body_text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "body_chars": {"type": "integer"},
          "sections": {
            "type": "array",
            "items": {"type": "object", "required": ["element_id", "anchor", "title", "level"],
                      "properties": {"element_id": {"type": "string"}, "anchor": {"type": "string"},
                                     "title": {"type": "string"}, "level": {"type": "integer"}}}
          }
        }
      }
    }
  }
}
