{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Retrieval chunk record (one line of chunks.jsonl)",
  "type": "object",
  "additionalProperties": false,
  "required": ["chunk_id", "pack_id", "pack_version", "document_id", "edition_id", "schema_version", "variant",
               "chunk_config_hash", "content_hash", "text", "heading_path", "content_type", "source_element_ids",
               "parent_section_id", "previous_chunk_id", "next_chunk_id", "required_context_ids", "required_context",
               "related_element_ids", "source_spans", "citation", "asset_refs", "note_refs", "warning_refs",
               "table_refs", "extraction", "tokenizer", "token_count", "oversize", "oversize_policy", "fragment",
               "overlap", "corpus", "include_in_default_retrieval", "exclusion_reason", "applicability",
               "authority_class", "superseded", "distribution", "review_status"],
  "properties": {
    "chunk_id": {"type": "string", "minLength": 8},
    "pack_id": {"type": "string"},
    "pack_version": {"type": "string"},
    "document_id": {"type": "string"},
    "edition_id": {"type": "string"},
    "schema_version": {"const": "1.0.0"},
    "variant": {"enum": ["local", "public"]},
    "chunk_config_hash": {"type": "string"},
    "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "text": {"type": "string", "minLength": 1},
    "heading_path": {"type": "array", "items": {"type": "string"}},
    "content_type": {"type": "string"},
    "source_element_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "parent_section_id": {"type": "string"},
    "previous_chunk_id": {"type": ["string", "null"]},
    "next_chunk_id": {"type": ["string", "null"]},
    "required_context_ids": {"type": "array", "items": {"type": "string"}},
    "required_context": {"type": "array", "items": {"type": "object", "required": ["id", "reason"],
      "properties": {"id": {"type": "string"}, "reason": {"type": "string"}}}},
    "related_element_ids": {"type": "array", "items": {"type": "string"}},
    "source_spans": {"type": "array", "items": {"type": "object",
      "required": ["locator_type", "element_id", "mapping_status"],
      "properties": {"locator_type": {"enum": ["pdf_page", "section_anchor", "native_record_id"]},
                     "page": {"type": ["integer", "null"]}, "page_label": {"type": ["string", "null"]},
                     "native_locator": {"type": ["string", "null"]}, "element_id": {"type": "string"},
                     "mapping_status": {"type": ["string", "null"]}, "url": {"type": "string"}}}},
    "citation": {"type": "object", "required": ["source", "edition", "locator_scheme", "text"]},
    "asset_refs": {"type": "array"},
    "note_refs": {"type": "array"},
    "warning_refs": {"type": "array"},
    "table_refs": {"type": "array"},
    "extraction": {"type": "object", "required": ["methods", "mapping_statuses", "validated_locators", "review_status"]},
    "tokenizer": {"type": "object", "required": ["id", "revision"]},
    "token_count": {"type": "integer", "minimum": 1},
    "oversize": {"type": "boolean"},
    "oversize_policy": {"type": ["string", "null"]},
    "fragment": {"type": ["object", "null"], "required": ["of_element_id", "policy", "index", "count"]},
    "overlap": {"type": ["object", "null"], "required": ["tokens", "from_chunk_id"]},
    "corpus": {"type": "string"},
    "include_in_default_retrieval": {"type": "boolean"},
    "exclusion_reason": {"type": ["string", "null"]},
    "applicability": {"type": "array", "items": {"type": "string"}},
    "authority_class": {"type": "string"},
    "superseded": {"type": "boolean"},
    "distribution": {"type": "object", "required": ["policy", "rights_state"],
      "properties": {"policy": {"type": "string"},
                     "rights_state": {"enum": ["redistributable", "metadata_only", "user_supplied_local", "pending_review"]}}},
    "review_status": {"type": "string"}
  },
  "allOf": [
    {"if": {"properties": {"include_in_default_retrieval": {"const": false}}},
     "then": {"properties": {"exclusion_reason": {"type": "string", "minLength": 3}}}}
  ]
}
